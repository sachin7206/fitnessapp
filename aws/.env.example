# ============================================================
# FitnessApp AWS Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# AWS Configuration
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID
AWS_REGION=us-east-1

# RDS MySQL Configuration
RDS_HOST=YOUR_RDS_ENDPOINT.rds.amazonaws.com
DB_USERNAME=admin
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD

# JWT Secret (use a strong random string, min 64 chars)
JWT_SECRET=YOUR_JWT_SECRET_CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_64_CHARS

# Email Configuration (for password reset, optional)
MAIL_USERNAME=
MAIL_PASSWORD=

# AI Service - Google Gemini API Keys (comma-separated)
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemma-3-27b-it

# Payment Configuration (optional)
MERCHANT_UPI_ID=fitnessapp@upi
MERCHANT_NAME=FitnessApp
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# Frontend URL (for CORS - set to your mobile web URL or * for all)
FRONTEND_URL=*

